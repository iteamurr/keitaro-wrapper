# Generate URL-safe random values, do not commit .env.
POSTGRES_PASSWORD=replace-with-url-safe-random-password
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+asyncpg://wrapper:replace-with-url-safe-random-password@127.0.0.1:5432/keitaro_wrapper
KEITARO_BASE_URL=https://tracker.example.invalid
KEITARO_API_KEY=
KEITARO_DOMAIN_ID=0
KEITARO_GROUP_ID=0
KEITARO_TRAFFIC_SOURCE_ID=0
CAMPAIGN_NAME_PREFIX=test_surname_
# Optional verified creation profile; see README. No unverified payload is sent.
KEITARO_CREATION_PROFILE=
